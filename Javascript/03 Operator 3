// ======================================================
// 1. CONDITIONAL / TERNARY OPERATOR (? :)
// ======================================================

/*
Ternary Operator ka use tab hota hai jab hume
condition ke according 2 statements me se ek
statement execute karna ho.

Syntax:

condition ? statement1 : statement2;

Agar condition TRUE hai  -> statement1
Agar condition FALSE hai -> statement2
*/


// Example:

let age = 20;

age >= 18
  ? console.log("You are eligible")
  : console.log("You are not eligible");

// Output:
// You are eligible


// ======================================================
// 2. TERNARY OPERATOR WITH VARIABLE
// ======================================================

let number = 10;

let result = number % 2 === 0
  ? "Even"
  : "Odd";

console.log(result);

// Output:
// Even


// ======================================================
// 3. TERNARY OPERATOR WITH PROMPT
// ======================================================

/*
Browser me prompt() user se input leta hai.

prompt() ka result normally STRING hota hai.

Isliye number ke liye Number() use karte hain.
*/

let num;

if (typeof prompt !== "undefined") {
  num = Number(prompt("Enter the number:"));
} else {
  num = 10; // default value for Node.js
}

num % 2 === 0
  ? console.log(`${num} is even`)
  : console.log(`${num} is odd`);


// ======================================================
// 4. TERNARY OPERATOR — SHORT FORM OF IF ELSE
// ======================================================

/*
Normal if-else:

if (age >= 18) {
    console.log("Adult");
} else {
    console.log("Not Adult");
}


Ternary:

age >= 18
    ? console.log("Adult")
    : console.log("Not Adult");
*/


// ======================================================
// 5. TERNARY OPERATOR — ASSIGNING VALUE
// ======================================================

let marks = 75;

let grade = marks >= 40 ? "Pass" : "Fail";

console.log(grade);

// Output:
// Pass


// ======================================================
// 6. NESTED TERNARY
// ======================================================

/*
Ternary ke andar ternary bhi use kar sakte hain.

Lekin bahut zyada nested ternary code ko difficult
bana deta hai. Aise case me if-else better hota hai.
*/

let marks2 = 85;

let grade2 =
    marks2 >= 90 ? "A+"
  : marks2 >= 80 ? "A"
  : marks2 >= 70 ? "B"
  : marks2 >= 60 ? "C"
  : marks2 >= 40 ? "D"
  : "Fail";

console.log(grade2);

// Output:
// A


