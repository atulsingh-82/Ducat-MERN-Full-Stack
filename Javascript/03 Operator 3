// ======================================================
// 7. INCREMENT OPERATOR (++ )
// ======================================================

/*
Increment ka matlab value ko 1 se increase karna.

x++  -> x = x + 1
++x  -> x = x + 1
*/


let x = 10;

x++;

console.log(x);

// Output:
// 11


// ======================================================
// 8. PRE-INCREMENT (++x)
// ======================================================

/*
Pre-Increment:

++x

Pehle increment
Phir value use hoti hai.
*/

let a = 10;

let b = ++a;

console.log(a); // 11
console.log(b); // 11

/*
Step:

a = 10

++a
a = 11

b = 11
*/


// ======================================================
// 9. POST-INCREMENT (x++)
// ======================================================

/*
Post-Increment:

x++

Pehle current value use hoti hai.
Uske baad increment hota hai.
*/

let c = 10;

let d = c++;

console.log(c); // 11
console.log(d); // 10

/*
Step:

c = 10

d = c  -> 10

then

c = c + 1
c = 11
*/


// ======================================================
// 10. PRE vs POST INCREMENT
// ======================================================

/*

PRE-INCREMENT
--------------

++x

1. First Increment
2. Then Assignment / Use


POST-INCREMENT
---------------

x++

1. First Assignment / Use
2. Then Increment
*/


// Example:

let p = 5;

console.log(++p);

// Output:
// 6


let q = 5;

console.log(q++);

// Output:
// 5

console.log(q);

// Output:
// 6


// ======================================================
// 11. DECREMENT OPERATOR (--)
// ======================================================

/*
Decrement ka matlab value ko 1 se decrease karna.

x--  -> x = x - 1
--x  -> x = x - 1
*/


let value = 10;

value--;

console.log(value);

// Output:
// 9


// ======================================================
// 12. PRE-DECREMENT (--x)
// ======================================================

/*
Pre-Decrement:

--x

1. First Decrement
2. Then Assignment / Use
*/

let m = 10;

let n3 = --m;

console.log(m);  // 9
console.log(n3); // 9


// ======================================================
// 13. POST-DECREMENT (x--)
// ======================================================

/*
Post-Decrement:

x--

1. First Assignment / Use
2. Then Decrement
*/

let r = 10;

let s = r--;

console.log(r); // 9
console.log(s); // 10


// ======================================================
// 14. PRE vs POST DECREMENT
// ======================================================

/*

PRE-DECREMENT
-------------

--x

1. First Decrement
2. Then Assignment / Use


POST-DECREMENT
--------------

x--

1. First Assignment / Use
2. Then Decrement
*/


// ======================================================
// 15. IMPORTANT EXAMPLE
// ======================================================

let A = 10;

let B = A++;

console.log("A =", A);
console.log("B =", B);

/*
A = 11
B = 10
*/


// Another:

let C = 10;

let D = ++C;

console.log("C =", C);
console.log("D =", D);

/*
C = 11
D = 11
*/


// ======================================================
// 16. COMBINING ++ AND --
// ======================================================

let z = 10;

console.log(z++); // 10
console.log(z);   // 11

console.log(++z); // 12

console.log(z--); // 12
console.log(z);   // 11

console.log(--z); // 10


// ======================================================
// 17. IMPORTANT: COMPLEX EXPRESSIONS
// ======================================================

/*
Jab ek hi expression me multiple ++ / -- lagte hain,
toh calculation ko step-by-step karna chahiye.

Example:

let a = 10;

let b = a++ - --a;

Step 1:
a++ -> current value 10 use hogi
a becomes 11

Step 2:
--a -> a becomes 10
value = 10

b = 10 - 10
b = 0
*/

let aa = 10;

let bb = aa++ - --aa;

console.log("aa =", aa);
console.log("bb =", bb);

// Output:
// aa = 10
// bb = 0


// ======================================================
// 18. ANOTHER COMPLEX EXAMPLE
// ======================================================

let x1 = 10;

let y1 = ++x1 + x1--;

console.log("x1 =", x1);
console.log("y1 =", y1);

/*
Step 1:
++x1
x1 = 11
value = 11

Step 2:
x1--
value = 11
then x1 = 10

Therefore:

y1 = 11 + 11
y1 = 22

Final:
x1 = 10
y1 = 22
*/


