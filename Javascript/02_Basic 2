// ==============================
// Operators
// ==============================

/*
Operators are special symbols used to perform
operations on operands (variables, constants,
or values).
*/

// ==============================
// Categories of Operators
// ==============================

/*
1. Unary Operator
   -> Requires one operand.

2. Binary Operator
   -> Requires two operands.

3. Ternary Operator
   -> Requires three operands.
*/

// ==============================
// Types of Operators
// ==============================

/*

1. Arithmetic Operators
2. Assignment Operators
3. Compound Assignment Operators
4. Relational Operators
5. Logical Operators
6. Bitwise Operators
7. Conditional (Ternary) Operator
8. Increment Operators
9. Decrement Operators
10. Miscellaneous Operators

*/

// ==============================
// Arithmetic Operators
// ==============================

/*

+   Addition

-   Subtraction

*   Multiplication

/   Division (Quotient)

%   Modulus (Remainder)

**  Exponent (Power)

*/

// ==============================
// Operator Precedence
// ==============================

/*

1. ()
2. **
3. * / %
4. + -

Associativity

+, -, *, /, %  --> Left to Right

**             --> Right to Left

*/

// ==============================
// Additions Examples
// ==============================

console.log(15 + 6); // 21

console.log("15" + 6); // "156"

console.log("15" + "6"); // "156"

console.log("15" + "Hello"); // "15Hello"

console.log(true + true); // 2

console.log(false + false); // 0

console.log(true + false); // 1

console.log(undefined + undefined); // NaN

console.log(null + null); // 0

console.log(null + undefined); // NaN

console.log(true + undefined); // NaN

console.log(10 + undefined); // NaN

// ==============================
// Substraction Examples
// ==============================
console.log(15 - 6); // 9

console.log("15" - 6); // 9

console.log("15" - "6"); // 9

console.log("15" - "Hello"); // NaN

console.log(true - true); // 0

console.log(false - false); // 0

console.log(true - false); // 0

console.log(undefined - undefined); // NaN

console.log(null - null); // 0

console.log(null - undefined); // NaN

console.log(true - undefined); // NaN

console.log(10 - undefined); // NaN

// ==============================
// Multiply Examples
// ==============================

console.log(15 * 6); // 90

console.log("15" * 6); // 90

console.log("15" * "6"); // 90

console.log("15" * "Hello"); // NaN

console.log(true * true); // 1

console.log(false * false); // 0

console.log(true * false); // 0

console.log(undefined * undefined); // NaN

console.log(null * null); // 0

console.log(null * undefined); // NaN

console.log(true * undefined); // NaN

console.log(10 * undefined); // NaN

// ==============================
// Division Example
// ==============================
console.log(15 / 6); // 2.5

console.log("15" / 6); // 2.5

console.log("15" / "6"); // 2.5

console.log("15" / "Hello"); // NaN

console.log(true / true); // 1

console.log(false / false); // NaN

console.log(true / false); // inf

console.log(undefined / undefined); // NaN

console.log(null / null); // NaN

console.log(null / undefined); // NaN

console.log(true / undefined); // NaN

console.log(10 / undefined); // NaN

// ==============================
//  % Example
// ==============================
console.log(15 % 6); // 3

console.log("15" % 6); // 3

console.log("15" % "6"); // 3

console.log("15" % "Hello"); // NaN

console.log(true % true); // 0

console.log(false % false); // NaN

console.log(true % false); // NaN

console.log(undefined % undefined); // NaN

console.log(null % null); // NaN

console.log(null % undefined); // NaN

console.log(true % undefined); // NaN

console.log(10 % undefined); // NaN

// ==============================
//  Power **
// ==============================
console.log(15 ** 6); // 11390625

console.log("15" ** 6); // 11390625

console.log("15" ** "6"); // 11390625

console.log("15" ** "Hello"); // NaN

console.log(true ** true); // 1

console.log(false ** false); // 1

console.log(true ** false); // 1

console.log(undefined ** undefined); // NaN

console.log(null ** null); // 1

console.log(null ** undefined); // NaN

console.log(true ** undefined); // NaN

console.log(10 ** undefined); // NaN

// ==============================
// Important Notes
// ==============================

/*

prompt()      -> Returns String

Number()      -> Converts into Number

parseInt()    -> Converts into Integer

parseFloat()  -> Converts into Decimal Number

NaN           -> Not a Number

Infinity      -> Infinite Value

null          -> Numeric value = 0

undefined     -> Converted result = NaN

*/

