// ============================================================
// 2. ASSIGNMENT OPERATOR
// ============================================================

/*
Assignment Operator:

Used to assign the value of the RHS (Right Hand Side)
to the LHS (Left Hand Side).

Symbol: =

Example:

let a = 10;        // valid

let sum = a + b;   // valid

let a = b = c;     // valid


Category: Binary
Associativity: Right to Left
*/


// ============================================================
// 3. COMPOUND / SHORT-HAND ASSIGNMENT OPERATORS
// ============================================================

/*
Combination of arithmetic operator + assignment operator.

a = a + b    =>    a += b

a = a - b    =>    a -= b

a = a * b    =>    a *= b

a = a / b    =>    a /= b

a = a % b    =>    a %= b

a = a ** b   =>    a **= b
*/


// ============================================================
// 4. RELATIONAL OPERATORS
// ============================================================

/*
Relational Operators:

Used to compare two values/operands.

<     Less than

<=    Less than or equal to

>     Greater than

>=    Greater than or equal to

!=    Not equal
      (checks value after type coercion)

!==   Not identical
      (checks value + data type)

==    Equal
      (checks value, type coercion can happen)

===   Strictly equal / Identical
      (checks value + data type)
*/


// ------------------------------------------------------------
// Examples
// ------------------------------------------------------------

console.log(155 < 7);          // false
console.log(155 > 7);          // true

console.log("155" < 7);        // false
console.log(155 < "7");        // false

console.log("155" < "7");      // true
// Both are strings, so comparison is lexicographical.

console.log("Amit" < "Nitin");  // true
console.log("Nitin" < "Amit");  // false

console.log("155" < "Amit");   // true


// ============================================================
// EQUALITY OPERATORS
// ============================================================

/*
Expression          ==       !=       ===      !==
-------------------------------------------------------
10 == 10            true     false    true     false

10 == "10"           true     false    false    true

10 === 10.0         true     false    true     false

10 === 10.1         false    true     false    true
*/


// ============================================================
// 5. LOGICAL OPERATORS
// ============================================================

/*
Logical Operators:

Used to make a compound condition.


Operator       Symbol       Category
------------------------------------------
Logical AND      &&         Binary

Logical OR       ||         Binary

Logical NOT       !         Unary
*/


// ------------------------------------------------------------
// Logical AND (&&)
// ------------------------------------------------------------

/*
Returns the first falsy value.

If all values are truthy,
it returns the last value.
*/

console.log(10 && 20);       // 20
console.log(0 && 20);        // 0
console.log(10 && 0);        // 0
console.log(0 && 0);         // 0
console.log(false && 0);     // false
console.log(0 && false);     // 0


// ------------------------------------------------------------
// Logical OR (||)
// ------------------------------------------------------------

/*
Returns the first truthy value.

If all values are falsy,
it returns the last value.
*/

console.log(10 || 20);       // 10
console.log(0 || 20);        // 20
console.log(10 || 0);        // 10
console.log(0 || 0);         // 0
console.log(false || 0);     // 0
console.log(0 || false);     // false


// ------------------------------------------------------------
// Logical NOT (!)
// ------------------------------------------------------------

/*
NOT operator reverses the truthiness of a value.
*/

console.log(!0);             // true
console.log(!10);            // false
console.log(!false);         // true
console.log(!true);          // false


